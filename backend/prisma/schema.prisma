generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BusinessType {
  RESTAURANT
  CAFE
  FASHION
  PERFUME
  BEAUTY
  ECOMMERCE
  REAL_ESTATE
  OTHER
}

enum BusinessGoal {
  MORE_MESSAGES
  MORE_LEADS
  MORE_ORDERS
  BOOK_APPOINTMENTS
  INCREASE_SALES
}

enum SocialPlatform {
  FACEBOOK
  INSTAGRAM
  WHATSAPP
}

enum ConversationChannel {
  FACEBOOK
  INSTAGRAM
  SIMULATION
  WHATSAPP
  TIKTOK
}

enum MessageRole {
  CUSTOMER
  AI
  HUMAN
  SYSTEM
}

enum LeadStatus {
  NEW
  QUALIFIED
  CONVERTED
  LOST
}

enum OrderStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  RETURNED
}

enum NotificationType {
  ORDER
  LEAD
  HANDOFF
  CAMPAIGN
  AI_RECOMMENDATION
  SYSTEM
}

enum PlanTier {
  FREE
  STARTER
  GROWTH
}

enum CampaignObjective {
  MORE_ORDERS
  MORE_LEADS
  MORE_BOOKINGS
  MORE_MESSAGES
  AWARENESS
  TRAFFIC
  ENGAGEMENT
  RETARGETING
}

enum CampaignStatus {
  DRAFT
  READY
  ASSISTED_LAUNCH
  SIMULATED
  ACTIVE
  PAUSED
  ARCHIVED
}

enum ConversionStage {
  NEW
  DISCOVERY
  QUALIFICATION
  CONSIDERATION
  PURCHASE_INTENT
  DATA_COLLECTION
  CONVERTED
  HUMAN_HANDOFF
}

enum ActorType {
  AI
  HUMAN
  SYSTEM
}

enum SocialConnectionStatus {
  DISCONNECTED
  CONNECTING
  CONNECTED
  REAUTH_REQUIRED
  ERROR
  SIMULATION
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  memberships         TeamMember[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model Business {
  id                    String         @id @default(uuid())
  name                  String
  type                  BusinessType   @default(OTHER)
  plan                  PlanTier       @default(FREE)
  description           String?
  averagePriceEgp       Int?
  operatingArea         String?
  contactChannels       String[]       @default([])
  primaryGoal           BusinessGoal?
  deliveryInfo          String?
  workingHours          String?
  paymentInfo           String?
  faqs                  String?
  /// Shared option catalogs for product variants: [{ id, name, values }]
  variantDictionary     Json           @default("[]")
  /// Shipping cost groups: [{ id, name, governorates, priceEgp }]
  shippingZones         Json           @default("[]")
  onboardingCompletedAt DateTime?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  members        TeamMember[]
  products       Product[]
  customers      Customer[]
  conversations  Conversation[]
  leads          Lead[]
  orders         Order[]
  socialAccounts SocialAccount[]
  pageComments   PageComment[]
  aiAgent        AIAgent?
  notifications  Notification[]
  campaigns      Campaign[]

  @@map("businesses")
}

model TeamMember {
  id         String   @id @default(uuid())
  businessId String
  userId     String
  role       String   @default("OWNER")
  createdAt  DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([businessId, userId])
  @@index([userId])
  @@map("team_members")
}

model Product {
  id          String   @id @default(uuid())
  businessId  String
  name        String
  description String?
  /// Base / from-price when variants exist (usually min SKU price)
  priceEgp    Int
  /// What the merchant paid for one unit. Null until recorded.
  costEgp     Int?
  /// Flexible per-business details (material, notes, area_m2, …)
  attributes  Json     @default("{}")
  /// Variant axes + SKU matrix: { axes: [{name, values}], skus: [{key, options, priceEgp, stockQuantity}] }
  variants    Json     @default("{\"axes\":[],\"skus\":[]}")
  /// Legacy convenience mirrors of attributes.sizes / attributes.colors / variant axes
  sizes       String[] @default([])
  colors      String[] @default([])
  /// Unit count for inventory items (sum of variant stocks when matrix exists). Null for availability-only.
  stockQuantity Int?
  inStock     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business   Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@index([businessId])
  @@map("products")
}

model Customer {
  id         String          @id @default(uuid())
  businessId String
  name       String?
  phone      String?
  externalId String?
  platform   SocialPlatform?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  business      Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  conversations Conversation[]
  leads         Lead[]
  orders        Order[]
  pageComments  PageComment[]

  @@index([businessId])
  @@index([businessId, phone])
  @@map("customers")
}

model Conversation {
  id              String              @id @default(uuid())
  businessId      String
  customerId      String
  campaignId      String?
  channel         ConversationChannel @default(SIMULATION)
  status          String              @default("OPEN")
  mode            String              @default("AI")
  conversionStage ConversionStage     @default(NEW)
  needsHuman      Boolean             @default(false)
  handoffReason   String?
  aiSummary       String?
  lastMessageAt   DateTime            @default(now())
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  campaign Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  messages Message[]
  leads    Lead[]
  pageComments PageComment[]

  @@index([businessId, lastMessageAt])
  @@index([campaignId])
  @@map("conversations")
}

model Message {
  id             String      @id @default(uuid())
  conversationId String
  role           MessageRole
  content        String
  intent         String?
  meta           Json?
  createdAt      DateTime    @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("messages")
}

model Lead {
  id             String     @id @default(uuid())
  businessId     String
  customerId     String
  conversationId String?
  campaignId     String?
  status         LeadStatus @default(NEW)
  intent         String?
  notes          String?
  createdBy      ActorType  @default(AI)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer     Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  campaign     Campaign?     @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([businessId, status])
  @@index([campaignId])
  @@map("leads")
}

model Order {
  id             String      @id @default(uuid())
  businessId     String
  customerId     String
  conversationId String?
  campaignId     String?
  orderNumber    Int
  status         OrderStatus @default(PENDING)
  totalEgp       Int
  /// Governorate id from the business shipping zones. Null until chosen.
  governorate    String?
  /// Shipping cost snapshotted from the matching zone. Null until a zone matches.
  shippingEgp    Int?
  customerName   String?
  customerPhone  String?
  notes          String?
  createdBy      ActorType   @default(AI)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  business Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  campaign Campaign?   @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  items    OrderItem[]

  @@unique([businessId, orderNumber])
  @@index([businessId, createdAt])
  @@index([campaignId])
  @@map("orders")
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  productId String?
  name      String
  size      String?
  color     String?
  quantity    Int     @default(1)
  priceEgp    Int
  /// Snapshotted from the product when the order was created.
  costEgp     Int?

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@map("order_items")
}

model SocialAccount {
  id                  String                 @id @default(uuid())
  businessId          String
  provider            String                 @default("META")
  platform            SocialPlatform
  externalId          String
  displayName         String?
  accessTokenEnc      String?
  refreshTokenEnc     String?
  tokenExpiresAt      DateTime?
  status              SocialConnectionStatus @default(DISCONNECTED)
  webhookSubscribedAt DateTime?
  parentExternalId    String?
  capabilities        String[]               @default([])
  metadata            Json?
  connectedAt         DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, platform])
  @@index([externalId])
  @@index([provider, externalId])
  @@map("social_accounts")
}

model PendingMetaConnection {
  id               String   @id @default(uuid())
  businessId       String
  userId           String
  userAccessTokenEnc String
  pagesJson        Json
  expiresAt        DateTime
  createdAt        DateTime @default(now())

  @@index([businessId])
  @@map("pending_meta_connections")
}

model WebhookEvent {
  id              String   @id @default(uuid())
  provider        String
  externalEventId String
  payload         Json
  processedAt     DateTime?
  status          String   @default("RECEIVED")
  error           String?
  createdAt       DateTime @default(now())

  @@unique([provider, externalEventId])
  @@index([createdAt])
  @@map("webhook_events")
}

model PageComment {
  id              String    @id @default(uuid())
  commentId       String    @unique
  postId          String
  pageId          String
  fromUserId      String
  message         String
  commentedAt     DateTime
  businessId      String
  customerId      String
  conversationId  String?
  rawPayload      Json?
  publicReplyId   String?
  publicRepliedAt DateTime?
  privateRepliedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer     Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([postId])
  @@index([customerId])
  @@index([conversationId])
  @@map("page_comments")
}

model AIAgent {
  id             String   @id @default(uuid())
  businessId     String   @unique
  primaryGoal    String   @default("GET_ORDERS")
  secondaryGoals String[] @default(["ANSWER_QUESTIONS", "QUALIFY", "HUMAN_HANDOFF"])
  isActive       Boolean  @default(true)
  tone           String   @default("FRIENDLY")
  instructions   String?
  commentFixedReply String?
  handoffEnabled Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("ai_agents")
}

model Notification {
  id         String           @id @default(uuid())
  businessId String
  type       NotificationType
  title      String
  body       String
  data       Json?
  readAt     DateTime?
  createdAt  DateTime         @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, createdAt])
  @@map("notifications")
}

model Campaign {
  id                  String            @id @default(uuid())
  businessId          String
  name                String
  objective           CampaignObjective
  status              CampaignStatus    @default(DRAFT)
  offer               String
  audienceDescription String
  budget              Int
  currency            String            @default("EGP")
  valueProposition    String?
  suggestedMessaging  String?
  suggestedCta        String?
  suggestedCreative   String?
  channel             String?
  startDate           DateTime?
  endDate             DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  business      Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  conversations Conversation[]
  leads         Lead[]
  orders        Order[]

  @@index([businessId, createdAt])
  @@map("campaigns")
}
