DATABASE_URL="postgresql://bay3ly:bay3ly@localhost:5432/bay3ly?schema=public"

JWT_ACCESS_SECRET="change-me-access-secret-min-32-chars"
JWT_REFRESH_SECRET="change-me-refresh-secret-min-32-chars"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

PORT=5000

# Comma-separated origins allowed for CORS (credentials). First URL is used for redirects.
# Local: http://localhost:5173
# Production example: https://bee3ly-system.vercel.app
# Both: https://bee3ly-system.vercel.app,http://localhost:5173
FRONTEND_URL="http://localhost:5173"

NODE_ENV="development"

TOKEN_ENCRYPTION_KEY="bee3ly-dev-encryption-key-32chars!!"

META_APP_ID=""
META_APP_SECRET=""
META_WEBHOOK_VERIFY_TOKEN="bee3ly-verify"

# WhatsApp Cloud API test number (Meta → WhatsApp → API Setup)
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""


# Temporary Dev fallback: poll Graph for Page comments (set false after Live feed webhooks work)
META_COMMENT_POLLING_ENABLED="true"
# Poll interval in ms (default 60000 = 1 minute). Minimum 10000.
META_COMMENT_POLL_INTERVAL_MS="60000"
# Optional override for the fixed public + private reply under new Page comments
META_COMMENT_FIXED_REPLY=""


# Must match a Valid OAuth Redirect URI in the Meta app.
# Local: http://localhost:5000/social/meta/callback
# Vercel/public (ngrok or deployed API): https://YOUR-PUBLIC-API/social/meta/callback
META_REDIRECT_URI="http://localhost:5000/social/meta/callback"
# WhatsApp Embedded Signup → Configuration ID (Settings → WhatsApp → Embedded Signup)
META_WHATSAPP_EMBEDDED_CONFIG_ID=""
# Must match where merchants open Settings (HTTPS). Used for Embedded Signup token exchange.
FRONTEND_URL="http://localhost:5173"
# Optional override if Meta still returns redirect_uri mismatch (36008):
# META_WHATSAPP_EMBEDDED_REDIRECT_URI="https://bee3ly-system.vercel.app/"
# After enabling Instagram Graph API (Facebook Login) in the Meta App:
# META_OAUTH_EXTRA_SCOPES="instagram_basic,instagram_manage_messages,instagram_manage_comments"

# TikTok for Developers (see docs/tiktok-integration.md)
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
TIKTOK_REDIRECT_URI="http://localhost:5000/social/tiktok/callback"
TIKTOK_WEBHOOK_VERIFY_TOKEN="bee3ly-tiktok-verify"

# External AI Engine (Bee3ly is NOT the brain — integrate later)
AI_SERVICE_URL="http://127.0.0.1:8000"
AI_ENGINE_URL=""
AI_ENGINE_API_KEY=""
AI_ENGINE_DEV_FALLBACK="true"
# In-memory cache for AI catalog + business prompt (ms). Default 45000.
AI_CONTEXT_CACHE_TTL_MS="45000"

OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
