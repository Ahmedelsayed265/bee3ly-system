DATABASE_URL="postgresql://bay3ly:bay3ly@localhost:5432/bay3ly?schema=public"

JWT_ACCESS_SECRET="change-me-access-secret-min-32-chars"
JWT_REFRESH_SECRET="change-me-refresh-secret-min-32-chars"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

PORT=3000

# Comma-separated origins allowed for CORS (credentials). First URL is used for redirects.
# Local: http://localhost:5173
# Production example: https://bee3ly-system.vercel.app
# Both: https://bee3ly-system.vercel.app,http://localhost:5173
FRONTEND_URL="http://localhost:5173"

NODE_ENV="development"

TOKEN_ENCRYPTION_KEY="bee3ly-dev-encryption-key-32chars!!"

META_APP_ID=""
META_APP_SECRET=""
META_WEBHOOK_VERIFY_TOKEN="bee3ly-verify"


# Temporary Dev fallback: poll Graph for Page comments (set false after Live feed webhooks work)
META_COMMENT_POLLING_ENABLED="true"
# Poll interval in ms (default 120000 = 2 minutes). Minimum 10000.
META_COMMENT_POLL_INTERVAL_MS="6000"
# Optional override for the fixed public + private reply under new Page comments
META_COMMENT_FIXED_REPLY=""


# Must match a Valid OAuth Redirect URI in the Meta app.
# Local: http://localhost:3000/social/meta/callback
# Vercel/public (ngrok or deployed API): https://YOUR-PUBLIC-API/social/meta/callback
META_REDIRECT_URI="http://localhost:3000/social/meta/callback"
# After enabling Instagram Graph API (Facebook Login) in the Meta App:
# META_OAUTH_EXTRA_SCOPES="instagram_basic,instagram_manage_messages,instagram_manage_comments"

# External AI Engine (Bee3ly is NOT the brain — integrate later)
AI_ENGINE_URL=""
AI_ENGINE_API_KEY=""
AI_ENGINE_DEV_FALLBACK="true"

OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
